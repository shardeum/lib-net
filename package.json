{
  "name": "@shardus/net",
  "version": "1.4.0",
  "description": "",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "binary": {
    "module_name": "shardus-net",
    "module_path": "native/{platform}-{arch}/",
    "remote_path": "./v{version}",
    "package_name": "{module_name}-v{version}-{node_abi}-{platform}-{arch}.tar.gz",
    "host": "https://github.com/shardeum/lib-net/releases/download"
  },
  "files": [
    "src/**/*",
    "build/**/*",
    "Cargo.*",
    "shardus_net/**/*",
    "crypto/**/*",
    "shardeum_utils/**/*",
    "scripts/**/*",
    "native/**/*"
  ],
  "scripts": {
    "install": "node-pre-gyp install --fallback-to-build || npm run build-rust-release",
    "build": "npm run build-rust-release && npm run build-node",
    "build-node": "tsc -p .",
    "build-rust": "./node_modules/.bin/cargo-cp-artifact --artifact cdylib shardus_net native/shardus-net.node -- cargo build --message-format=json-render-diagnostics",
    "build-rust-debug": "npm run build-rust --",
    "build-rust-release": "npm run build-rust -- --release",
    "package-binary": "node-pre-gyp package",
    "publish-binary": "node-pre-gyp publish",
    "compile": "npm run build-node",
    "test:cargo": "cargo test",
    "lint": "eslint \"./src/**/*.ts\"",
    "format-check": "prettier --check \"./src/**/*.ts\"",
    "format-fix": "prettier --write \"./src/**/*.ts\"",
    "clean": "cargo clean",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shardeum/lib-net.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "contributors": [
    "Aaron Sullivan",
    "Derrick Farris",
    "Aamir Syed",
    "Kyle Shifflett",
    "James Harmon"
  ],
  "engines": {
    "node": "18.19.1"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "^1.0.11",
    "uuid": "3.3.2"
  },
  "devDependencies": {
    "cargo-cp-artifact": "0.1",
    "@ethereumjs/tx": "5.4.0",
    "@ethereumjs/util": "9.1.0",
    "@types/node": "18.19.1",
    "@types/uuid": "7.0.0",
    "@typescript-eslint/eslint-plugin": "5.57.0",
    "@typescript-eslint/parser": "5.57.0",
    "eslint": "8.47.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-no-unsanitized": "4.0.2",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-xss": "0.1.12",
    "gts": "3.1.0",
    "prettier": "2.7.1",
    "typescript": "4.4.4",
    "@types/jest": "27.0.1",
    "jest": "27.1.1",
    "ts-jest": "27.0.5"
  },
  "overrides": {
    "got": "11.8.5"
  }
}